{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "07xh-space-worker",
  "compatibility_date": "2026-11-20",
  "main": "./.worker-dist/index.js",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": [
      "/admin",
      "/api/auth/*",
      "/api/admin/*"
    ]
  }
}
