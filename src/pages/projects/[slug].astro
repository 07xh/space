---
import Base from '../../layouts/Base.astro';
import {getProjects} from '../../lib/content';
export async function getStaticPaths(){return(await getProjects()).filter(p=>!['firefly','example-project'].includes(p.id)).map(p=>({params:{slug:p.id},props:{project:p}}));}
const {project}=Astro.props;
const stateLabel={implemented:'已实现',verifying:'验证中',planned:'规划中'};
---
<Base title={project.data.title+' · 07xh'} description={project.data.description}>
<article class="project-detail">
 <a class="back" href="/projects/">← 全部项目</a>
 <header><span class="eyebrow">PROJECT / {project.data.subtitle||'07xh'}</span>
 <h1>{project.data.title}<span class="period">.</span></h1><p>{project.data.description}</p>
 <div class="project-tags">{project.data.tags.map(t=><span>{t}</span>)}</div>
 </header>
 <div class="project-detail-body"><h2>主要功能</h2>
 <div class="project-features">{project.data.highlights.map((h,i)=><section class="project-feature"><small>{String(i+1).padStart(2,'0')}</small><div><h3>{h.title}</h3><p>{h.detail}</p></div><span>{stateLabel[h.state]}</span></section>)}</div>
 <h2>项目链接</h2><div class="project-links">{project.data.link.map(l=><a href={l.value} target="_blank" rel="noreferrer">{l.label} ↗</a>)}</div>
 </div>
</article></Base>
