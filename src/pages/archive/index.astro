---
import Base from '../../layouts/Base.astro';
import {getPosts} from '../../lib/content';
const posts=await getPosts();
const years=Object.groupBy(posts,p=>String(p.data.published.getFullYear()));
---
<Base title="文章归档 · 07xh"><section class="editorial">
<span class="eyebrow">ARCHIVE / 07xh</span><h1 class="page-title">文章归档<span class="period">.</span></h1>
<p class="intro">按年份整理的全部公开文章。</p>
{Object.entries(years).sort(([a],[b])=>Number(b)-Number(a)).map(([year,entries])=><section class="archive-year"><h2>{year}</h2><div class="post-list">{(entries||[]).map(p=><a href={'/posts/'+p.id+'/'} class="archive-row"><time>{p.data.published.toISOString().slice(5,10)}</time><strong>{p.data.title}</strong><span>↗</span></a>)}</div></section>)}
</section></Base>
