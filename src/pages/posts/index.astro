---
import Base from '../../layouts/Base.astro';
import {getPosts} from '../../lib/content';
const posts=await getPosts();
---
<Base title="文章 · 07xh"><section class="editorial"><div class="eyebrow">JOURNAL / TECHNOLOGY</div>
<h1 class="page-title">文章<span class="period">.</span></h1><p class="intro">关于 Python、工程制图、网络调试，以及做软件时遇到的问题。</p>
<div class="post-list">{posts.map((p,i)=><a href={'/posts/'+p.id+'/'} class="post-row">
<span class="post-count">{String(i+1).padStart(2,'0')}</span><div class="post-info"><strong>{p.data.title}</strong><p>{p.data.description}</p>
<small>{p.data.category||'笔记'} · {p.data.published.toISOString().slice(0,10)}</small></div><span aria-hidden="true">↗</span></a>)}</div>
</section></Base>
