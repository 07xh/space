---
// Adapted from fqzlr/fqzlr-bk/src/components/layout/HomeCompass.astro (MIT).
// Links use Space's own routes instead of the reference site's settings.
import '../styles/components/home-compass.css';
const items=[
 {name:'文章',url:'/posts/',icon:'▤'}, {name:'归档',url:'/archive/',icon:'▦'},
 {name:'项目',url:'/projects/',icon:'◇'}, {name:'动态',url:'/dynamic/',icon:'◷'},
 {name:'搜索',url:'/search/',icon:'⌕'}, {name:'关于',url:'/about/',icon:'↗'}
];
---
<section class="home-compass" aria-label="快速导航">
  <div class="home-compass__inner">
    <header class="home-compass__header"><h2 class="home-compass__title">在这里逛逛</h2><p class="home-compass__subtitle">文章、项目和最近更新，都能直接找到</p></header>
    <nav class="home-compass__grid" aria-label="网站内容导航">
      {items.map(item=><a class="home-compass__item" href={item.url}><span class="home-compass__icon" aria-hidden="true">{item.icon}</span><span class="home-compass__label">{item.name}</span></a>)}
    </nav>
  </div>
</section>
